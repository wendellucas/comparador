<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema inicial exibido antes do primeiro frame Flutter; mantém fundo dark slate sem flash branco -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema normal após o primeiro frame; background alinhado ao Scaffold (#0F172A) -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:colorBackground">@color/splash_background</item>
    </style>
</resources>
